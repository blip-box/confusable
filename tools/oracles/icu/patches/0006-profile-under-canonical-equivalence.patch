 // Computes the restriction level of a string, according to UTS 39 section 5.2.
+// UTS #39 section 3.1: canonical equivalence applies when testing for allowed
+// characters. Each segment of the text passes if all its characters are
+// allowed in its NFD form or in its NFC form.
+UBool SpoofImpl::inProfile(const UnicodeString& input, UErrorCode& status) const {
+    const Normalizer2* nfd = Normalizer2::getNFDInstance(status);
+    const Normalizer2* nfc = Normalizer2::getNFCInstance(status);
+    if (U_FAILURE(status)) { return false; }
+    UnicodeString decomposed = nfd->normalize(input, status);
+    int32_t length = decomposed.length();
+    int32_t start = 0;
+    for (int32_t i = 0; U_SUCCESS(status);) {
+        UChar32 c = i < length ? decomposed.char32At(i) : 0;
+        if (i == length || (i > start && nfc->hasBoundaryBefore(c))) {
+            UnicodeString segment(decomposed, start, i - start);
+            if (!fAllowedCharsSet->containsAll(segment)
+                    && !fAllowedCharsSet->containsAll(nfc->normalize(segment, status))) {
+                return false;
+            }
+            start = i;
+        }
+        if (i == length) { break; }
+        i += U16_LENGTH(c);
+    }
+    return U_SUCCESS(status);
+}
+
 URestrictionLevel SpoofImpl::getRestrictionLevel(const UnicodeString& input, UErrorCode& status) const {
     // Section 5.2 step 1:
-    if (!fAllowedCharsSet->containsAll(input)) {
+    if (!inProfile(input, status)) {
         return USPOOF_UNRESTRICTIVE;
     }
 
